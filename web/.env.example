APP_NAME="Peaje IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://peaje-ia.onrender.com
APP_LOCALE=es
APP_TIMEZONE=America/La_Paz
LOG_CHANNEL=stderr

# Postgres gestionado (Neon / Render). Una sola variable con la URL completa.
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:clave@host/basedatos?sslmode=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Google OAuth 2.0 (Google Cloud Console > Credenciales > ID de cliente OAuth "Aplicación web")
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://peaje-ia.onrender.com/auth/google/callback
# Audiencias aceptadas para el ID token de la app móvil (normalmente el mismo client ID web)
GOOGLE_ALLOWED_AUDIENCES=xxxxxxxx.apps.googleusercontent.com

# Lista blanca inicial (además del docente, que siempre es admin)
ADMIN_EMAILS=tu.correo@gmail.com
OPERADOR_EMAILS=

# Tiempo real (Pusher Channels, plan Sandbox gratuito)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

# Endpoint de inferencia (RunPod: https://<POD_ID>-8000.proxy.runpod.net  |  Colab: URL pública)
INFERENCE_URL=
INFERENCE_API_KEY=
INFERENCE_TIMEOUT=40
PEAJE_CONFIANZA_MINIMA=0.5
PEAJE_VENTANA_DUPLICADO=60

# Agente (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
